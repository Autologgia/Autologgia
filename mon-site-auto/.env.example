# Rollback-safe default: any absent or unknown value keeps Sanity active.
CMS_SOURCE=sanity

# Source Sanity historique et stockage optionnel des demandes d'estimation.
# Les trois variables NEXT_PUBLIC_* ne contiennent pas de secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=replace-with-your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
# Optionnel : active la copie historique des estimations dans Sanity.
# Préférer SANITY_WRITE_TOKEN ; SANITY_AUTH_TOKEN reste un alias de compatibilité.
SANITY_WRITE_TOKEN=replace-with-a-server-only-write-token
# SANITY_AUTH_TOKEN=replace-with-a-server-only-write-token

# Required only when CMS_SOURCE=supabase. These values are server-only.
SYNERGY_CMS_API_URL=http://localhost:3200
SYNERGY_CMS_DELIVERY_TOKEN=replace-with-a-random-server-token
HISTORY_ACCESS_SECRET=replace-with-at-least-32-random-characters

# Invalidation du cache « poussée » par Synergy après chaque modification
# (POST /api/cms/revalidate). Doit être IDENTIQUE à CMS_CONSUMER_SECRET_AUTOLOGGIA
# côté Synergy. Sans cette variable la route répond 503 et le site ne se met à
# jour qu'au bout du filet de 300 s (revalidate). Serveur uniquement.
CMS_REVALIDATE_SECRET=replace-with-a-random-shared-secret
# Optionnel. Préfixe des tags de cache et site_key attendu par la revalidation
# (défaut : autologgia).
CMS_SITE_KEY=autologgia

# Revenue Engine : transfert serveur-à-serveur des leads (contact/estimation)
# vers Synergy. Réutilise SYNERGY_CMS_API_URL. Optionnel : si absent, les
# formulaires continuent de fonctionner normalement (email Resend uniquement),
# aucun lead n'est transmis à Synergy. Jamais exposé via NEXT_PUBLIC_*.
SYNERGY_LEAD_INGESTION_TOKEN=replace-with-a-random-server-token

# Envoi d'emails transactionnels (formulaires contact / estimation / historique).
RESEND_API_KEY=replace-with-your-resend-api-key
# Obligatoire en production : utiliser une adresse d'un domaine vérifié Resend.
# Sans valeur, l'expediteur de développement est onboarding@resend.dev.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Optionnel. Sans valeur, les emails partent vers autologgia.web@gmail.com (prod).
# En local, si la cle Resend est en mode test, mettre ici l'adresse du compte Resend.
RESEND_TO_EMAIL=
